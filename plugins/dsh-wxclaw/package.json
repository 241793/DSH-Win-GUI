{
  "name": "dsh-wxclaw",
  "version": "0.1.0",
  "description": "WxClaw (ilink Bot) WeChat channel plugin for deepseek-harness (dsh): scan QR to bind a WeChat account and chat with dsh through WeChat.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wechat",
    "wxclaw",
    "ilink-bot",
    "im-channel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<你的用户名>/dsh-wxclaw.git"
  },
  "bugs": {
    "url": "https://github.com/<你的用户名>/dsh-wxclaw/issues"
  },
  "homepage": "https://github.com/<你的用户名>/dsh-wxclaw#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": ">=3.18.1"
  }
}
